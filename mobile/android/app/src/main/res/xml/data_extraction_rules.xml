<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what Android may copy to Google Drive (cloud-backup) or to
     a new phone (device-transfer). The data file may go, so a new phone can
     restore it; progress photos never leave this phone (E8-S1).
     tests/test_mobile_app.py checks these rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="progress-photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="progress-photos/" />
    </device-transfer>
</data-extraction-rules>
