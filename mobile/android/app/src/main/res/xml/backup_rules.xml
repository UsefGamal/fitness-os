<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0 and 8.1 (API 26-27): Android ignores requireFlags there, so
     the rules in xml-v28/ would send health data to Google Drive without
     end-to-end encryption (pentest AND-07). On these phones nothing is
     backed up: use Settings > "Export a backup" to move to a new phone. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
