<?xml version="1.0" encoding="utf-8"?>
<!-- A set going, open: the folded row, the exercise photo, the workout so
     far, the weight with -/+, and Open workout / Done set (logs it and
     starts the rest). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/notif_set" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/s_photo"
            android:layout_width="96dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:background="#ffffff"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8e8e93"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/notif_adjust" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/s_open"
            style="@style/NotifButton" />

        <TextView
            android:id="@+id/s_done"
            style="@style/NotifButton"
            android:layout_marginEnd="0dp"
            android:background="@drawable/notif_btn_go"
            android:textColor="#000000" />
    </LinearLayout>
</LinearLayout>
