{
  "name": "fitness-os-mobile",
  "private": true,
  "version": "0.9.8",
  "type": "module",
  "description": "The standalone Fitness OS phone app. Runs inside the APK, data saved on the phone.",
  "scripts": {
    "content": "python3 ../scripts/export_content.py src/content.json",
    "check:friends": "python3 ../scripts/check_friends_build.py",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "test": "npm run content && node --test src/lib/*.test.js && npm run test:store",
    "test:store": "VITE_FAKE_FS=1 node --import ./scripts/node-stubs/register.mjs --test src/store/*.test.js",
    "coverage": "npm run content && node scripts/coverage.mjs",
    "lint:i18n": "node scripts/i18n-lint.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run lint:i18n && npm run typecheck && npm test",
    "e2e": "npm run build && node e2e/harness.mjs",
    "e2e:device": "npm run content && VITE_FAKE_FS=1 vite build --outDir dist-device && node e2e/device.mjs",
    "e2e:journeys": "npm run content && VITE_FAKE_FS=1 vite build --outDir dist-device && node e2e/journeys.mjs",
    "build:mobile": "npm run photos && npm run build && cap sync android",
    "photos": "python3 ../scripts/fetch_exercise_photos.py public/exercise-db"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
