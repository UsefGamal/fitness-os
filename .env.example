# Copy this file to .env and fill in real values. Never commit .env.
APP_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
DATABASE_URL=sqlite:///./fitness.db
# For production (Neon Postgres), use something like:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
RESEND_API_KEY=
DIGEST_EMAIL_TO=you@example.com
CRON_SECRET=another-random-string
APP_BASE_URL=https://fitness-os.onrender.com
FITCHEF_CLIENT_ID=
FITCHEF_CLIENT_SECRET=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
# Web push (evening nudge reminders) — generate a keypair once with:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); ..."
# (see routers/push.py's module docstring for the exact snippet). The same
# keypair works for local dev and production; it does not need to be per-env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com
