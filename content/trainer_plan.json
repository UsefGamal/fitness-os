  "tempo_note": "Every exercise: 3 s down, 0 s pause, 1 s up, 0 s pause at the top.",
  "glossary": {
    "sets": "How many sets you do of the exercise.",
    "reps": "How many reps per set, e.g. 12-15.",
    "rest": "Rest between sets, in minutes unless marked sec. Rest between different exercises can be 1-2 min.",
    "rir": "Pre* = reps left in reserve before failure. If you can just manage 10 reps with 30 kg, *1 means stop at 9 and *2 means stop at 8.",
    "rir_last_to_failure": "*1-F: every set stops short of failure except the last, which goes to failure.",
    "failure": "Failure written on an exercise: every set goes to muscular failure.",
    "warm_up": "Light to medium weights only, to prepare muscles and joints.",
    "paired_set": "Alternate two exercises: a set of A, rest the time shown, a set of B, rest, until all sets are done.",
    "normal_set": "The heaviest weight that still hits the reps with the Pre* target.",
    "warm_up_ramp": "Warm up 20-90%: if your working weight is 50 kg for 10, start at 20% of it and step up set by set to 80-90%, so the first working set starts at a real weight."
  },
  "general_notes": [
    "Warming up is very important to prevent injuries and prepare muscles and joints to carry weights. Warm up with light weights."
  ],
